---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Catalog from '../components/Catalog.astro';
import WhyPika from '../components/WhyPika.astro';
import Mentors from '../components/Mentors.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import InfoStrip from '../components/InfoStrip.astro';
import FloatingActions from '../components/FloatingActions.astro';
---

<Layout title="PIKA Skill Space - Tempat Anak Berani Jadi Pemimpin">
  <Header />
	<main>
		<Hero />
    <Catalog />
    <WhyPika />
    <Mentors />
    <Testimonials />
    <FAQ />
    <InfoStrip />
	</main>
  
  <FloatingActions />

	<footer class="pika-footer">
		<div class="container footer-content">
      <!-- Area kiri dikosongkan untuk menghindari Logo yang ada di Gambar Background -->
      <div class="footer-left-area"></div>

			<div class="footer-links-container">
        <!-- Kolom 2: Jelajahi (Dua Sub-kolom) -->
        <div class="footer-col footer-nav">
          <h5 class="col-title">JELAJAHI</h5>
          <div class="nav-columns">
            <ul class="clean-list">
              <li><a href="/">Beranda</a></li>
              <li><a href="#program">Program</a></li>
              <li><a href="#why">Tentang PIKA</a></li>
            </ul>
            <ul class="clean-list">
              <li><a href="#mentor">Mentor</a></li>
              <li><a href="#testimoni">Testimoni</a></li>
              <li><a href="#faq">FAQ</a></li>
            </ul>
          </div>
        </div>

        <!-- Kolom 3: Kontak Kami -->
        <div class="footer-col footer-contact">
          <h5 class="col-title">KONTAK KAMI</h5>
          <ul class="clean-list contact-items">
            <li>
              <img src="https://api.iconify.design/lucide:phone.svg?color=white" width="20" alt="phone">
              <a href="tel:085196046014">0851-9604-6014</a>
            </li>
            <li>
              <img src="https://api.iconify.design/lucide:mail.svg?color=white" width="20" alt="mail">
              <a href="mailto:pikaskillspace@gmail.com">pikaskillspace@gmail.com</a>
            </li>
            <li>
              <img src="https://api.iconify.design/lucide:map-pin.svg?color=white" width="20" alt="location">
              <span>Jalan Setiabudhi Kota Bandung</span>
            </li>
          </ul>
        </div>

        <!-- Kolom 4: Sosial Media -->
        <div class="footer-col footer-social">
          <h5 class="col-title">IKUTI KAMI</h5>
          <div class="social-row">
            <a href="#" class="social-btn" title="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            </a>
            <a href="#" class="social-btn" title="TikTok">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
            </a>
            <a href="#" class="social-btn" title="YouTube">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 2-2h15a2 2 0 0 1 2 2 24.12 24.12 0 0 1 0 10 2 2 0 0 1-2 2h-15a2 2 0 0 1-2-2Z"/><path d="m10 15 5-3-5-3z"/></svg>
            </a>
            <a href="#" class="social-btn" title="Facebook">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
          </div>
        </div>
      </div>
		</div>

		<div class="footer-bottom">
			<p>© 2024 PIKA Skill Space. All Rights Reserved.</p>
		</div>
	</footer>

  <script>
    // Header Visibility Logic
    const header = document.querySelector('header');
    const heroSection = document.querySelector('.hero-section');
    
    if (header && heroSection) {
      window.addEventListener('scroll', () => {
        const heroHeight = heroSection.offsetHeight;
        const scrollPos = window.scrollY;
        
        if (scrollPos > heroHeight * 0.7) {
          header.classList.add('header-hidden');
        } else {
          header.classList.remove('header-hidden');
        }
      });
    }

    // Smooth scroll
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });
  </script>
</Layout>

<style>
	.pika-footer {
		padding: 5rem 0 2rem;
		background: #0B2447 url('/assets/BG_Footer.png') no-repeat center bottom;
    background-size: cover;
    color: white;
    position: relative;
    border-top: 1px solid rgba(255,255,255,0.05);
	}

	.footer-content {
		max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: flex-end;
    align-items: start;
    z-index: 2;
    position: relative;
	}

  .footer-left-area {
    flex: 1;
    min-width: 350px; /* Jarak untuk logo di gambar background */
  }

  .footer-links-container {
    display: grid;
    grid-template-columns: 1.8fr 1.5fr 1fr;
    gap: 3rem;
    flex: 2;
  }

  .col-title {
    color: white;
    margin-bottom: 2rem;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    display: block;
    height: 1.5rem; /* Ensure same horizontal line for titles */
  }

  .logo {
    font-size: 1.8rem;
    font-weight: 900;
    color: white;
    margin-bottom: 1.5rem;
    margin-top: -0.5rem;
  }

  .logo .accent {
    color: #5DEBD7;
  }

  .tagline {
    font-size: 0.95rem;
    color: rgba(255,255,255,0.7);
    line-height: 1.6;
  }

  .nav-columns {
    display: flex;
    gap: 3rem;
  }

  .clean-list {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .clean-list li {
    margin-bottom: 1rem;
    list-style: none !important;
  }

  .footer-col a {
    color: rgba(255,255,255,0.8);
    text-decoration: none !important;
    font-size: 0.95rem;
    transition: all 0.3s ease;
  }

  .footer-col a:hover {
    color: white;
    padding-left: 5px;
  }

  .contact-items li {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 1.2rem;
    color: rgba(255,255,255,0.8);
  }

  .social-row {
    display: flex;
    gap: 1.2rem;
    margin-top: -0.3rem; /* Slight shift to align with title line */
  }

  .social-btn {
    color: white;
    opacity: 0.8;
    transition: all 0.3s ease;
  }

  .social-btn:hover {
    opacity: 1;
    color: #FFC03D;
    transform: translateY(-5px);
  }

	.footer-bottom {
		text-align: center;
		padding-top: 3rem;
		margin-top: 4rem;
		border-top: 1px solid rgba(255,255,255,0.1);
		font-size: 0.9rem;
		color: rgba(255,255,255,0.4);
    position: relative;
    z-index: 2;
	}

  @media (max-width: 1024px) {
    .footer-content {
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 0 1.5rem;
    }
    
    .footer-left-area {
      display: none;
    }

    .footer-links-container {
      width: 100%;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .footer-links-container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      text-align: center;
    }

    .col-title {
      height: auto;
      margin-bottom: 1.25rem;
    }

    .nav-columns {
      justify-content: center;
      gap: 2rem;
    }

    .contact-items li {
      justify-content: center;
    }

    .social-row {
      justify-content: center;
    }
  }
</style>
