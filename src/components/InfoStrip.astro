---
const items = [
  { icon: '🎮', text: 'Kelas Interaktif dan Menyenangkan' },
  { icon: '📖', text: 'Metode Terbukti dan Terstruktur' },
  { icon: '🛡️', text: 'Lingkungan Positif dan Aman' },
  { icon: '📊', text: 'Laporan Perkembangan Setiap Anak' }
];
---

<section class="info-strip">
  <div class="container strip-grid">
    {items.map(item => (
      <div class="strip-item">
        <span class="icon-circle">{item.icon}</span>
        <p>{item.text}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .info-strip {
    background: #EBF1F8;
    padding: 4rem 0;
  }

  .strip-grid {
    display: flex;
    justify-content: center;
    gap: 4rem;
    flex-wrap: wrap;
  }

  .strip-item {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    flex: 1;
    min-width: 200px;
  }

  .icon-circle {
    width: 60px;
    height: 60px;
    background: white;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    box-shadow: var(--shadow-soft);
  }

  .strip-item p {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--pika-blue);
    line-height: 1.3;
    max-width: 150px;
  }

  @media (max-width: 768px) {
    .strip-grid { justify-content: center; }
    .strip-item { flex: none; width: 45%; }
  }
</style>
