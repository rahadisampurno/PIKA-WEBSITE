<header id="mainHeader" class="pika-header-container">
  <nav class="pika-navbar">
    <div class="nav-logo">
      <img src="/assets/logo.jpg" alt="PIKA Logo" class="logo-img" />
      <div class="logo-text-group">
        <span class="logo-title">PIKA <span class="green">SKILL SPACE</span></span>
        <span class="logo-sub">Tempat Anak Tumbuh dan Berkembang</span>
      </div>
    </div>
    
    <ul class="nav-menu">
      <li><a href="/" class="active">Beranda</a></li>
      <li><a href="#program">Program</a></li>
      <li><a href="#why">Tentang PIKA</a></li>
      <li><a href="#mentor">Mentor</a></li>
      <li><a href="#testimoni">Testimoni</a></li>
      <li><a href="#harga">Harga</a></li>
      <li><a href="#faq">FAQ</a></li>
    </ul>

    <div class="nav-action">
      <a href="https://wa.me/6285196046014?text=Halo%20PIKA,%20saya%20tertarik%20untuk%20mencoba%20Trial%20Class!" target="_blank" rel="noopener noreferrer" class="btn-trial">Coba Trial Class</a>
    </div>
  </nav>
</header>

<script is:inline>
  function setupHeaderBehavior() {
    const header = document.getElementById('mainHeader');
    const hero = document.querySelector('.hero-pika');
    if (!header || !hero) return;

    function update() {
      const currentScrollY = window.scrollY;
      const heroHeight = hero.offsetHeight;
      const heroBottom = hero.offsetTop + heroHeight - 100;

      // HIDE IF OUTSIDE HERO
      if (currentScrollY > heroBottom) {
        header.classList.add('header-hidden');
      } else {
        header.classList.remove('header-hidden');
      }
    }

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeaderBehavior);
  } else {
    setupHeaderBehavior();
  }
</script>

<style>
  .pika-header-container {
    position: fixed;
    top: 20px;
    left: 0;
    width: 100%;
    z-index: 1000;
    padding: 0 20px;
    transition: transform 0.6s cubic-bezier(0.68, -0.6, 0.32, 1.6), opacity 0.5s ease;
    will-change: transform, opacity;
  }

  /* Sembunyi total saat meninggalkan area Hero */
  .header-hidden {
    transform: translateY(-160%) scale(0.8);
    opacity: 0;
    pointer-events: none;
  }

  .pika-navbar {
    max-width: 1100px;
    margin: 0 auto;
    background: transparent;
    backdrop-filter: blur(0px);
    padding: 10px 25px;
    border-radius: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: none;
    border: 1px solid transparent;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    
    /* MODALITAS: Sedikit transparan saat tidak di-hover, tapi tetap terbaca */
    opacity: 0.6; 
    pointer-events: auto;
  }

  /* HOVER state: Muncul Jelas */
  .pika-navbar:hover {
    opacity: 1 !important;
    background: rgba(255, 255, 255, 0.98) !important;
    backdrop-filter: blur(15px) !important;
    box-shadow: 0 15px 40px rgba(0,0,0,0.15) !important;
    border: 1px solid rgba(255,255,255,0.8) !important;
    transform: scale(1.02);
  }

  .nav-logo { display: flex; align-items: center; gap: 12px; }
  .logo-img { width: 45px; height: 45px; border-radius: 12px; }
  .logo-text-group { display: flex; flex-direction: column; }
  .logo-title { font-size: 1.2rem; font-weight: 900; color: #2D3E50; line-height: 1; }
  .logo-title .green { color: #40A18B; }
  .logo-sub { font-size: 0.65rem; color: #6C7A89; font-weight: 600; }
  .nav-menu { display: flex; list-style: none; gap: 1.5rem; margin: 0; padding: 0; }
  .nav-menu a { text-decoration: none; color: #2D3E50; font-size: 0.9rem; font-weight: 700; transition: all 0.3s ease; position: relative; padding: 5px 0; }
  .nav-menu a:hover, .nav-menu a.active { color: #FFC03D; }
  .btn-trial { background: #FA5D5D; color: white; text-decoration: none; padding: 10px 24px; border-radius: 50px; font-weight: 800; font-size: 0.9rem; box-shadow: 0 4px 0 #c44545; transition: all 0.2s ease; display: inline-block; }

  @media (max-width: 1024px) {
    .nav-menu { display: none; }
  }
</style>
