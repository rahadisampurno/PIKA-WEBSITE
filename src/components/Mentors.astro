---
const mentors = [
  { name: 'Kak nisa', role: 'COO/ Operations', color: 'var(--pika-red)', image: '/assets/nisa.png', ig: 'nisaadk' },
  { name: 'Kak Anisa', role: 'CEO/Lead', color: 'var(--pika-green)', image: '/assets/anisa.jpg', ig: 'dipusparaga' },
  { name: 'Kak Bintang', role: 'CMO/ Growth', color: 'var(--pika-yellow)', image: '/assets/bintang.png', ig: 'Bintangads' }
];
---

<section id="mentor" class="mentors-section" style="background-image: url('/assets/BG_MentorKami.png'); background-repeat: no-repeat; background-position: center top; background-size: cover;">
  <div class="mentors-inner">
    <h2 class="section-title">✦ TIM PIKA ✦</h2>
    <div class="mentor-grid">
      {mentors.map(m => (
        <div class="ref-card">
          <div class="img-bx">
             {m.image ? (
               <img src={m.image} alt={m.name} class="mentor-img" style={`border-color: ${m.color}`} />
             ) : (
               <div class="img-placeholder" style={`border-color: ${m.color}`}>👤</div>
             )}
          </div>
          <div class="content">
            <div class="detail">
              <h2>{m.name}<br /><span>{m.role}</span></h2>
              <ul class="sci">
                <li>
                  <a href={`https://instagram.com/${m.ig}`} target="_blank" rel="noopener noreferrer" style={`--ac: ${m.color}`}><img src="https://api.iconify.design/lucide:instagram.svg?color=currentColor" width="18" alt="instagram"></a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="mentor-banner clay-card">
       <div class="banner-item">
          <span class="icon">🎓</span>
          <p>Mentor kami bukan hanya mengajar, tapi menginspirasi dan menjadi teman berproses anak-anak.</p>
       </div>
       <div class="banner-features">
          <div class="b-feat"><span>👤</span> Berpengalaman mengajar anak</div>
          <div class="b-feat"><span>✅</span> Dilatih dengan metode PIKA</div>
          <div class="b-feat"><span>💡</span> Penuh energi dan inspiratif</div>
       </div>
    </div>
  </div>
</section>

<style>
  .mentors-section {
    padding: 100px 0;
    background-image: url('/assets/BG_MentorKami.png') !important;
    background-repeat: no-repeat !important;
    background-position: center top !important;
    background-size: cover !important;
    position: relative;
  }

  .mentors-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    position: relative;
    z-index: 2;
  }

  .mentor-grid {
    display: flex;
    justify-content: center;
    gap: 2.5rem;
    flex-wrap: wrap;
    margin-bottom: 4rem;
    width: 100%;
    max-width: 1100px;
    margin-left: auto;
    margin-right: auto;
  }

  .ref-card {
    position: relative;
    width: 320px;
    height: 460px;
    background: rgba(255, 255, 255, 0.45);
    border-radius: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    box-shadow: 0 15px 25px rgba(0, 0, 0, 0.04);
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease;
    flex-shrink: 0;
  }

  .ref-card:hover {
    transform: translateY(-12px);
    box-shadow: 0 25px 45px rgba(0, 0, 0, 0.12);
    background: rgba(255, 255, 255, 0.6);
  }

  .img-bx {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 12px;
    overflow: hidden;
    transform: translateY(22px) scale(0.64);
    transform-origin: top;
    transition: transform 0.4s ease;
  }

  .ref-card:hover .img-bx {
    transform: translateY(16px) scale(0.67);
  }

  .img-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #f1f5f9;
    border-radius: 20px;
    border: 5px solid;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 5.5rem;
    color: #cbd5e1;
    box-shadow: inset 0 2px 6px rgba(0,0,0,0.05);
  }

  .mentor-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 20px;
    border: 5px solid;
    background-color: #f1f5f9;
    box-shadow: inset 0 2px 6px rgba(0,0,0,0.05);
  }

  .content {
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    padding-bottom: 22px;
  }

  .content .detail {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    text-align: center;
    padding: 0 14px;
    width: 100%;
  }

  .content .detail h2 {
    color: #2D3E50;
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.35;
    margin-bottom: 4px;
    letter-spacing: -0.2px;
  }

  .content .detail h2 span {
    font-size: 0.74rem;
    color: #15803d; /* Nice high contrast dark green for the role */
    font-weight: 700;
    display: block;
    margin-top: 4px;
    line-height: 1.3;
  }

  .sci {
    position: relative;
    display: flex;
    margin-top: 6px;
    padding: 0;
  }

  .sci li {
    list-style: none;
    margin: 4px;
  }

  .sci li a {
    width: 34px;
    height: 34px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    background: white;
    font-size: 1.2em;
    color: #2D3E50;
    text-decoration: none;
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.08), 0 3px 6px rgba(0, 0, 0, 0.12);
    transition: 0.4s ease;
  }

  .sci li a:hover {
    background: var(--ac, #03a9f4);
    color: #fff;
    transform: scale(1.1);
  }

  .mentor-banner {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    align-items: center;
    gap: 3rem;
    background: rgba(235, 241, 248, 0.9);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    padding: 2.5rem;
    border-radius: 32px;
  }

  .banner-item { display: flex; gap: 1.5rem; align-items: center; }
  .banner-item .icon { font-size: 3rem; }
  .banner-item p { font-weight: 700; font-size: 1.15rem; color: var(--pika-blue); line-height: 1.5; }

  .banner-features {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .b-feat {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-dark);
  }

  @media (max-width: 1024px) {
    .mentor-grid {
      flex-wrap: wrap;
    }
  }

  @media (max-width: 768px) {
    .mentor-banner { grid-template-columns: 1fr; gap: 1.5rem; padding: 2rem 1.5rem; }
    .banner-features { grid-template-columns: 1fr; }
  }
</style>
