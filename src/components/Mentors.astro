---
const mentors = [
  { 
    name: 'Kak Nisa', 
    fullName: 'Nisa Dwi Kumalasari',
    role: 'COO/ Operations', 
    color: 'var(--pika-red)', 
    image: '/assets/nisa.webp', 
    ig: 'nisaadk',
    desc: 'Lulusan Pendidikan Matematika, Universitas Pendidikan Indonesia, dengan pengalaman di bidang pendidikan selama 5 tahun. Kak Nisa berperan dalam memastikan kualitas operasional dan pengembangan program berjalan secara efektif untuk menghadirkan pengalaman belajar terbaik bagi setiap anak.'
  },
  { 
    name: 'Kak Anisa', 
    fullName: 'Anisa Rahma',
    role: 'CEO/Lead', 
    color: 'var(--pika-green)', 
    image: '/assets/anisa.webp', 
    ig: 'dipusparaga',
    desc: 'Lulusan Pendidikan Bahasa Daerah, Universitas Pendidikan Indonesia, dengan pengalaman lebih dari 10 tahun di bidang pendidikan. Berkomitmen membangun ruang belajar yang membantu anak mengembangkan rasa percaya diri, keterampilan komunikasi, dan keberanian tampil sejak dini.'
  },
  { 
    name: 'Kak Bintang', 
    fullName: 'Bintang',
    role: 'CMO/ Growth', 
    color: 'var(--pika-yellow)', 
    image: '/assets/bintang.webp', 
    ig: 'Bintangads',
    desc: 'Lulusan Pendidikan Ekonomi, Universitas Pasundan, dengan pengalaman dalam bidang pendidikan selama 5 tahun. Kak Bintang berperan dalam mengembangkan strategi pemasaran dan memperluas dampak program untuk menghadirkan pengalaman belajar yang bermakna bagi setiap anak.'
  },
  { 
    name: 'Kak Aulia', 
    fullName: 'Aulia',
    role: 'Mentor', 
    color: '#f97316', 
    image: '/assets/aulia.jpg', 
    ig: 'aauliassy',
    desc: 'Mentor dengan latar belakang pendidikan Bimbingan dan Konseling dari Ma’soem University. Berpengalaman sebagai private teacher serta aktif sebagai volunteer di Sekolah Anak Nusantara, ia memiliki ketertarikan dalam mendampingi tumbuh kembang anak melalui pendekatan yang suportif, komunikatif, dan menyenangkan.'
  },
  { 
    name: 'Kak Ali', 
    fullName: 'Ali Ilham',
    role: 'Mentor', 
    color: '#3b82f6', 
    image: '/assets/ali.jpg', 
    ig: 'alie.ilhamal',
    desc: 'Lulusan Ilmu Hadits, Universitas Al Azhar, Kairo, Mesir. Aktif sebagai pendongeng di Komunitas Gendong, MC, serta berpengalaman memfasilitasi program edukasi daring. Berfokus mendukung perkembangan kemampuan komunikasi dan kepercayaan diri anak melalui pengalaman belajar yang menyenangkan.'
  }
];
---

<section id="mentor" class="mentors-section" style="background-image: url('/assets/BG_MentorKami.webp'); background-repeat: no-repeat; background-position: center top; background-size: cover;">
  <div class="mentors-inner">
    <h2 class="section-title">✦ TIM PIKA ✦</h2>
    <div class="mentor-grid">
      {mentors.map(m => (
        <div class="ref-card">
          <div class="img-bx">
             {m.image ? (
               <img src={m.image} alt={m.name} class="mentor-img" style={`border-color: ${m.color}`} />
             ) : (
               <div class="img-placeholder" style={`border-color: ${m.color}`}>👤</div>
             )}
          </div>
          <div class="content">
            <div class="detail">
              <h2>{m.name}<br /><span>{m.role}</span></h2>
              <ul class="sci">
                <li>
                  <a href={`https://instagram.com/${m.ig}`} target="_blank" rel="noopener noreferrer" style={`--ac: ${m.color}`}><img src="https://api.iconify.design/lucide:instagram.svg?color=currentColor" width="18" alt="instagram"></a>
                </li>
              </ul>
            </div>
          </div>
          
          <!-- Hover Overlay Details -->
          <div class="card-overlay" style={`border-color: ${m.color}`}>
             <h3 class="overlay-name" style={`color: ${m.color}`}>{m.fullName}</h3>
             <h4 class="overlay-role">{m.role}</h4>
             <p class="overlay-desc">{m.desc}</p>
             <ul class="sci overlay-sci">
                <li>
                  <a href={`https://instagram.com/${m.ig}`} target="_blank" rel="noopener noreferrer" style={`--ac: ${m.color}`}><img src="https://api.iconify.design/lucide:instagram.svg?color=currentColor" width="18" alt="instagram"></a>
                </li>
             </ul>
          </div>
        </div>
      ))}
    </div>

    <div class="mentor-banner clay-card">
       <div class="banner-item">
          <span class="icon">🎓</span>
          <p>Mentor kami bukan hanya mengajar, tapi menginspirasi dan menjadi teman berproses anak-anak.</p>
       </div>
       <div class="banner-features">
          <div class="b-feat"><span>👤</span> Berpengalaman mengajar anak</div>
          <div class="b-feat"><span>✅</span> Dilatih dengan metode PIKA</div>
          <div class="b-feat"><span>💡</span> Penuh energi dan inspiratif</div>
       </div>
    </div>
  </div>
</section>

<style>
  .mentors-section {
    padding: 100px 0;
    background-image: url('/assets/BG_MentorKami.webp') !important;
    background-repeat: no-repeat !important;
    background-position: center top !important;
    background-size: cover !important;
    position: relative;
  }

  .mentors-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    position: relative;
    z-index: 2;
  }

  .mentor-grid {
    display: flex;
    justify-content: center;
    gap: 2.5rem;
    flex-wrap: wrap;
    margin-bottom: 4rem;
    width: 100%;
    max-width: 1100px;
    margin-left: auto;
    margin-right: auto;
  }

  .ref-card {
    position: relative;
    width: 320px;
    height: 460px;
    background: rgba(255, 255, 255, 0.45);
    border-radius: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    box-shadow: 0 15px 25px rgba(0, 0, 0, 0.04);
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease;
    flex-shrink: 0;
  }

  .ref-card:hover {
    transform: translateY(-12px);
    box-shadow: 0 25px 45px rgba(0, 0, 0, 0.12);
    background: rgba(255, 255, 255, 0.6);
  }

  .img-bx {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 12px;
    overflow: hidden;
    transform: translateY(22px) scale(0.64);
    transform-origin: top;
    transition: all 0.4s ease;
  }

  .ref-card:hover .img-bx {
    transform: translateY(10px) scale(0.64);
    filter: blur(8px) opacity(0.3);
  }

  .img-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #f1f5f9;
    border-radius: 20px;
    border: 5px solid;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 5.5rem;
    color: #cbd5e1;
    box-shadow: inset 0 2px 6px rgba(0,0,0,0.05);
  }

  .mentor-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 20px;
    border: 5px solid;
    background-color: #f1f5f9;
    box-shadow: inset 0 2px 6px rgba(0,0,0,0.05);
  }

  .content {
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    padding-bottom: 22px;
    transition: all 0.4s ease;
  }

  .ref-card:hover .content {
    opacity: 0;
    transform: translateY(10px);
  }

  .content .detail {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    text-align: center;
    padding: 0 14px;
    width: 100%;
  }

  .content .detail h2 {
    color: #2D3E50;
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.35;
    margin-bottom: 4px;
    letter-spacing: -0.2px;
  }

  .content .detail h2 span {
    font-size: 0.74rem;
    color: #15803d; /* Nice high contrast dark green for the role */
    font-weight: 700;
    display: block;
    margin-top: 4px;
    line-height: 1.3;
  }

  .sci {
    position: relative;
    display: flex;
    margin-top: 6px;
    padding: 0;
  }

  .sci li {
    list-style: none;
    margin: 4px;
  }

  .sci li a {
    width: 34px;
    height: 34px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    background: white;
    font-size: 1.2em;
    color: #2D3E50;
    text-decoration: none;
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.08), 0 3px 6px rgba(0, 0, 0, 0.12);
    transition: 0.4s ease;
  }

  .sci li a:hover {
    background: var(--ac, #03a9f4);
    color: #fff;
    transform: scale(1.1);
  }

  /* Overlay Styles */
  :global(.card-overlay) {
    position: absolute;
    top: 0; 
    left: 0; 
    width: 100%; 
    height: 100%;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-radius: 24px;
    padding: 2.5rem 1.5rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    z-index: 10;
    border: 4px solid transparent; 
  }

  :global(.ref-card:hover .card-overlay) {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  :global(.overlay-name) {
    font-size: 1.25rem;
    font-weight: 900;
    margin-bottom: 4px;
    line-height: 1.2;
  }

  :global(.overlay-role) {
    font-size: 0.8rem;
    font-weight: 700;
    color: #64748b;
    margin-bottom: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  :global(.overlay-desc) {
    font-size: 0.88rem;
    line-height: 1.5;
    color: #334155;
    margin-bottom: 1rem;
    flex-grow: 1;
    display: flex;
    align-items: center;
  }

  :global(.overlay-sci) {
    margin-top: 0;
  }

  .mentor-banner {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    align-items: center;
    gap: 3rem;
    background: rgba(235, 241, 248, 0.9);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    padding: 2.5rem;
    border-radius: 32px;
  }

  .banner-item { display: flex; gap: 1.5rem; align-items: center; }
  .banner-item .icon { font-size: 3rem; }
  .banner-item p { font-weight: 700; font-size: 1.15rem; color: var(--pika-blue); line-height: 1.5; }

  .banner-features {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .b-feat {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-dark);
  }

  @media (max-width: 1024px) {
    .mentor-grid {
      flex-wrap: wrap;
    }
  }

  @media (max-width: 768px) {
    .mentor-banner { grid-template-columns: 1fr; gap: 1.5rem; padding: 2rem 1.5rem; }
    .banner-features { grid-template-columns: 1fr; }
  }
</style>
